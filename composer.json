{
    "name": "kavenegar/php",
    "type": "library",
    "description": "A PHP wrapper for Kavenegar's API",
    "keywords": [
        "kavenegar",
        "sms",
        "api"
    ],
    "homepage": "http://github.com/Kavenegar/kavenegar-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Kavenegar API Team",
            "email": "support@kavenegar.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Kavenegar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kavenegar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/phpunit/phpunit/phpunit --testsuite Unit",
        "test:live": "@php vendor/phpunit/phpunit/phpunit --testsuite Live",
        "lint": "@php tools/lint.php"
    },
    "minimum-stability": "stable"
}
